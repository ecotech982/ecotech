{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profile data stored upon registration or login",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "providerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "contact_messages": {
      "title": "Contact Messages",
      "description": "Messages submitted via the website contact form and synced to Google Sheets",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "syncedToSheets": { "type": "boolean" }
      },
      "required": ["name", "email", "message"]
    }
  }
}
